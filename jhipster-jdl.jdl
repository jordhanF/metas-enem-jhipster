entity Aluno {
    nome String required
    email String required
    dataNascimento LocalDate
}

entity Meta {
    linguagens Integer min(0) max(1000)
    humanas Integer min(0) max(1000)
    natureza Integer min(0) max(1000)
    matematica Integer min(0) max(1000)
    dataMeta LocalDate
}

relationship OneToMany {
    Aluno{meta} to Meta{aluno(nome) required}
}

dto * with mapstruct
service * with serviceImpl
paginate Aluno, Meta with pagination